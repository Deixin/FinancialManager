{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Financial Manager — US-001",
  "version": "0.1.0",
  "identifier": "com.miudos.financial-manager.us001",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "US-001 · Cofre Desktop",
        "width": 720,
        "height": 520,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["spike-main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": false }
}
