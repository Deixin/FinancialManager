{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Financial Manager",
  "version": "0.1.0",
  "identifier": "com.miudos.financial-manager.desktop",
  "build": { "frontendDist": "../frontend-dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Financial Manager",
        "width": 1120,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "capabilities": ["entry-main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
