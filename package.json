{
  "name": "financial-manager",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "env:check": "node infra/scripts/doctor.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:repo": "node infra/scripts/check-repository.mjs",
    "lint": "eslint . --max-warnings 0 && pnpm check:repo",
    "typecheck": "turbo run typecheck",
    "test": "node --test infra/scripts/check-repository.test.mjs",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
