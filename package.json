{
  "name": "financial-manager",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "revisions:test": "turbo run build && node infra/revisions/run.mjs",
    "revisions:clean": "node infra/revisions/clean.mjs",
    "fixtures:generate": "node infra/fixtures/generate.mjs",
    "fixtures:check": "node infra/fixtures/generate.mjs --check",
    "fixtures:test": "turbo run build && node infra/fixtures/run.mjs",
    "fixtures:clean": "node infra/fixtures/clean.mjs",
    "query:gate": "turbo run build && node infra/query/run.mjs",
    "repositories:test": "turbo run build && node infra/query/run.mjs --repositories",
    "repositories:clean": "node infra/query/clean.mjs",
    "check:data-access": "node infra/scripts/check-data-access.mjs",
    "identity:generate": "node infra/identity/generate.mjs",
    "identity:check": "node infra/identity/generate.mjs --check",
    "identity:test": "turbo run build && node infra/identity/run.mjs",
    "identity:clean": "node infra/identity/clean.mjs",
    "identity:native:windows": "node infra/identity/native.mjs windows",
    "identity:native:android:build": "turbo run build && node infra/identity/native.mjs android-build",
    "identity:native:android:test": "node infra/identity/native.mjs android-test",
    "schema:migrations:generate": "node infra/schema/generate-migrations.mjs",
    "schema:migrations:check": "node infra/schema/generate-migrations.mjs --check",
    "schema:migrations:test": "turbo run build --filter=@financial-manager/storage-schema && node infra/schema/migrations.mjs",
    "schema:migrations:clean": "node infra/schema/migrations-clean.mjs",
    "schema:sqlite:generate": "node infra/schema/generate-sqlite.mjs",
    "schema:sqlite:check": "node infra/schema/generate-sqlite.mjs --check",
    "schema:dual:test": "turbo run build --filter=@financial-manager/storage-schema && node infra/schema/dual.mjs",
    "schema:dual:clean": "node infra/schema/dual-clean.mjs",
    "schema:native:desktop": "node infra/schema/native.mjs desktop",
    "schema:native:android:build": "turbo run build --filter=@financial-manager/storage-schema && node infra/schema/native.mjs android-build",
    "schema:native:android:test": "node infra/schema/native.mjs android-test",
    "schema:test": "node infra/schema/run.mjs test",
    "schema:clean": "node infra/schema/run.mjs clean",
    "config:check": "turbo run build --filter=@financial-manager/runtime-config && node infra/config/check.mjs",
    "ui:serve": "turbo run build && node infra/ui/serve.mjs",
    "ui:check": "turbo run build && node infra/ui/check.mjs && node infra/ui/check-flags.mjs",
    "env:stack:check": "node infra/scripts/run-environments.mjs check",
    "env:stack:up": "node infra/scripts/run-environments.mjs up",
    "env:stack:verify": "node infra/scripts/run-environments.mjs verify",
    "env:stack:down": "node infra/scripts/run-environments.mjs down",
    "env:stack:test": "node infra/scripts/run-environments.mjs test",
    "contracts:generate": "node infra/scripts/generate-contracts.mjs",
    "contracts:check": "node infra/scripts/generate-contracts.mjs --check",
    "env:check": "node infra/scripts/doctor.mjs",
    "spike:physical:test": "node infra/scripts/run-physical-spike.mjs",
    "spike:importers:test": "node infra/scripts/run-importer-spike.mjs test",
    "spike:importers:clean": "node infra/scripts/run-importer-spike.mjs clean",
    "spike:sync:test": "node infra/scripts/run-sync-spike.mjs test",
    "spike:sync:down": "node infra/scripts/run-sync-spike.mjs down",
    "spike:rls:test": "node infra/scripts/run-rls-spike.mjs test",
    "spike:rls:down": "node infra/scripts/run-rls-spike.mjs down",
    "spike:oidc:setup": "node infra/scripts/run-oidc-spike.mjs setup",
    "spike:oidc:serve": "node infra/scripts/run-oidc-spike.mjs serve",
    "spike:oidc:test": "node infra/scripts/run-oidc-spike.mjs test",
    "spike:oidc:down": "node infra/scripts/run-oidc-spike.mjs down",
    "spike:mobile:prebuild": "node infra/scripts/run-mobile-spike.mjs prebuild",
    "spike:mobile:setup:android": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/homologation/us002-android-setup.ps1",
    "spike:mobile:build:android": "node infra/scripts/run-mobile-spike.mjs build-android",
    "spike:mobile:test:android": "node infra/scripts/run-mobile-spike.mjs test-android",
    "spike:desktop:test": "node infra/scripts/run-desktop-spike.mjs test",
    "spike:desktop:check": "node infra/scripts/run-desktop-spike.mjs check",
    "spike:desktop:ui": "node infra/scripts/run-desktop-spike.mjs ui",
    "spike:desktop:cli": "node infra/scripts/run-desktop-spike.mjs cli",
    "spike:desktop:package": "node infra/scripts/run-desktop-spike.mjs package",
    "spike:desktop:vm:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/homologation/us001-setup.ps1",
    "spike:desktop:vm:test": "node infra/homologation/us001-run.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:repo": "node infra/scripts/check-repository.mjs",
    "lint": "eslint . --max-warnings 0 && pnpm check:repo && pnpm check:data-access && pnpm fixtures:check && pnpm contracts:check && pnpm env:stack:check && pnpm config:check && pnpm schema:sqlite:check && pnpm schema:migrations:check && pnpm identity:check",
    "typecheck": "turbo run typecheck && tsc -p infra/ui/tsconfig.json && tsc -p infra/identity/tsconfig.json && tsc -p infra/query/tsconfig.gate.json && tsc -p infra/revisions/tsconfig.json",
    "test": "turbo run build && node --test infra/scripts/*.test.mjs",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "kysely": "0.29.6",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
