{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/config/tsconfig.base.json",
    "packages/config/workspace-boundaries.json",
    "eslint.config.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  }
}
